@using System.Security.Claims
@using FirstBlazorApp.Services.IService
@inject IHttpContextAccessor HttpContextAccessor
@inject IDynamicMenuService MenuService
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="main-layout">
    <!-- Side Navigation -->
    <div class="sidebar-nav">
        <div class="nav-header">
            <div class="brand-logo">
                <div class="logo-icon">🏢</div>
                <div class="brand-text">
                    <h3>Enterprise Portal</h3>
                    <p>Admin Dashboard</p>
                </div>
            </div>
        </div>

        <nav class="nav-menu">

            <!-- Dashboard — always visible -->
            <div class="nav-item @GetActiveClass("/dashboard")">
                <NavLink href="/dashboard" class="nav-link d-flex align-items-center">
                    <span class="nav-icon dashboard-icon me-2">⌂</span>
                    <span class="nav-text">Dashboard</span>
                </NavLink>
            </div>

            @if (_menuGroups == null)
            {
                <div class="nav-item">
                    <span class="nav-link d-flex align-items-center" style="opacity:0.4">
                        <span class="nav-icon me-2">⏳</span>
                        <span class="nav-text">Loading...</span>
                    </span>
                </div>
            }
            else
            {
                @foreach (var group in _menuGroups)
                {
                    @if (group.Items.Count == 1)
                    {
                        var item = group.Items[0];
                        <div class="nav-item @GetActiveClass(item.NavigationUrl)">
                            <NavLink href="@item.NavigationUrl" class="nav-link d-flex align-items-center">
                                <span class="nav-icon me-2">@group.IconCode</span>
                                <span class="nav-text">@group.DisplayName</span>
                                <span class="nav-arrow ms-auto">›</span>
                            </NavLink>
                        </div>
                    }
                    else
                    {
                        var groupId = group.FormId;
                        var isExpanded = _expandedGroups.Contains(groupId);
                        var isGroupActive = group.Items.Any(i => IsPathActive(i.NavigationUrl));

                        <div class="nav-item users-dropdown @(isExpanded ? "active" : "") @(isGroupActive ? "active" : "")">
                            <div class="nav-link d-flex align-items-center"
                                 style="cursor:pointer"
                                 @onclick="() => ToggleGroup(groupId)">
                                <span class="nav-icon me-2">@group.IconCode</span>
                                <span class="nav-text">@group.DisplayName</span>
                                <div class="nav-arrow ms-auto @(isExpanded ? "expanded" : "")">
                                    @(isExpanded ? "▼" : "▶")
                                </div>
                            </div>

                            @if (isExpanded)
                            {
                                <div class="submenu">
                                    @foreach (var item in group.Items)
                                    {
                                        <NavLink href="@item.NavigationUrl"
                                                 class="@($"submenu-item {GetActiveClass(item.NavigationUrl)}")">
                                            <span class="submenu-icon">›</span>
                                            <span class="submenu-text">@item.FunctionalityName</span>
                                        </NavLink>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            }

        </nav>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        <!-- Top Header -->
        <div class="page-header">
            <div class="header-left">
                @if (!HideBackButton)
                {
                    <button class="back-btn" @onclick="GoBack">
                        <span class="back-icon">←</span>
                    </button>
                }
                <div class="header-info">
                    <span class="greeting">Good Day, <strong>@(!string.IsNullOrEmpty(_userFirstName) ? _userFirstName.ToUpper() : "SUPER")</strong></span>
                    <div class="user-badge">@(!string.IsNullOrEmpty(_userFirstName) ? _userFirstName.Substring(0, 1).ToUpper() : "S")</div>
                </div>
            </div>

            <div class="header-right">
                <button class="logout-btn" @onclick="Logout">
                    <span class="logout-icon">🚪</span>
                    <span class="logout-text">Logout</span>
                </button>
            </div>
        </div>

        <!-- Page Content -->
        <div class="page-content">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? BackUrl { get; set; }
    [Parameter] public bool HideBackButton { get; set; } = false;

    private List<MenuGroupDto>? _menuGroups;
    private HashSet<int> _expandedGroups = new();
    private string _userFirstName = "";

    protected override async Task OnInitializedAsync()
    {
        var user = HttpContextAccessor.HttpContext?.User;
        if (user?.Identity?.IsAuthenticated == true)
            _userFirstName = user.FindFirst("FirstName")?.Value ?? "";

        _menuGroups = await MenuService.GetMenuForCurrentUserAsync();

        // Auto-expand groups that contain the current path
        var currentPath = HttpContextAccessor.HttpContext?.Request.Path.Value?.ToLower() ?? "";
        foreach (var group in _menuGroups.Where(g => g.Items.Count > 1))
        {
            if (group.Items.Any(i => currentPath.StartsWith(i.NavigationUrl.ToLower())))
                _expandedGroups.Add(group.FormId);
        }
    }

    private void ToggleGroup(int formId)
    {
        if (!_expandedGroups.Remove(formId))
            _expandedGroups.Add(formId);
        StateHasChanged();
    }

    private string GetActiveClass(string path)
    {
        return IsPathActive(path) ? "active" : "";
    }

    private bool IsPathActive(string path)
    {
        if (string.IsNullOrEmpty(path)) return false;
        var currentPath = HttpContextAccessor.HttpContext?.Request.Path.Value?.ToLower() ?? "";
        return currentPath.StartsWith(path.ToLower());
    }

    private void GoBack()
    {
        Nav.NavigateTo(!string.IsNullOrEmpty(BackUrl) ? BackUrl : "/dashboard");
    }

    private void Logout() => Nav.NavigateTo("/logout");
}
