@inherits LayoutComponentBase
@attribute [Authorize]

<div class="authenticated-layout">
    <SimpleNavMenu />
    
    <div class="main-content">
        @Body
    </div>
</div>

<style>
    .authenticated-layout {
        display: flex;
        min-height: 100vh;
    }

    .main-content {
        flex: 1;
        margin-left: 280px;
        min-height: 100vh;
        background: #f8fafc;
        transition: margin-left 0.3s ease;
        padding: 24px;
    }

    @@media (max-width: 768px) {
        .main-content {
            margin-left: 70px;
            padding: 16px;
        }
    }
</style>