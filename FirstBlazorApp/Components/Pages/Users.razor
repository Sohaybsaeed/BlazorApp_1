@page "/users"
@page "/users/view"
@layout Layout.AuthenticatedLayout
@attribute [Authorize]
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav
@rendermode InteractiveServer

<!-- Main Content -->
<div class="users-content">
    <div class="users-card">
        <h1 class="users-title">👤 User Management</h1>

        <!-- ── Identity & Permissions (featured card) ── -->
        <div class="identity-featured-card" @onclick='() => Nav.NavigateTo("/users/identity-management")'>
            <div class="identity-featured-icon">🔐</div>
            <div class="identity-featured-info">
                <h2>Identity &amp; Permissions</h2>
                <div class="identity-featured-chips">
                    <span>🏷️ Roles</span>
                    <span>👥 User Roles</span>
                    <span>🔑 Permissions</span>
                </div>
            </div>
            <div class="identity-featured-arrow">›</div>
        </div>
        
        <div class="users-menu-grid">
            <div class="menu-card" @onclick="() => NavigateToCreateUser()">
                <div class="menu-icon create-user-icon">➕</div>
                <div class="menu-info">
                    <h3>Create User</h3>
                    <p>Add new users to the system</p>
                </div>
                <div class="menu-arrow">›</div>
            </div>

            <div class="menu-card" @onclick="() => NavigateToViewAllUsers()">
                <div class="menu-icon view-users-icon">👥</div>
                <div class="menu-info">
                    <h3>View &amp; Edit Users</h3>
                    <p>Manage existing users</p>
                </div>
                <div class="menu-arrow">›</div>
            </div>

            <div class="menu-card" @onclick='() => Nav.NavigateTo("/users/external-logins")'>
                <div class="menu-icon" style="font-size:1.6rem;background:linear-gradient(135deg,#0ea5e9,#0284c7);border-radius:12px;width:56px;height:56px;display:flex;align-items:center;justify-content:center;">🔗</div>
                <div class="menu-info">
                    <h3>External Logins</h3>
                    <p>View &amp; remove OAuth links</p>
                </div>
                <div class="menu-arrow">›</div>
            </div>

            <div class="menu-card" @onclick='() => Nav.NavigateTo("/users/tokens")'>
                <div class="menu-icon" style="font-size:1.6rem;background:linear-gradient(135deg,#f59e0b,#d97706);border-radius:12px;width:56px;height:56px;display:flex;align-items:center;justify-content:center;">🎟️</div>
                <div class="menu-info">
                    <h3>User Tokens</h3>
                    <p>View &amp; revoke stored tokens</p>
                </div>
                <div class="menu-arrow">›</div>
            </div>
        </div>
    </div>
</div>

@code {
    private void NavigateToCreateUser()
    {
        Nav.NavigateTo("/users/create");
    }

    private void NavigateToViewAllUsers()
    {
        Nav.NavigateTo("/users/list");
    }
}